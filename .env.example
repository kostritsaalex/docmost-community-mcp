# Base URL of your self-hosted Docmost instance (no trailing /api required)
DOCMOST_URL=https://docs.example.com

# Community Edition auth — email/password login, session cached locally
DOCMOST_EMAIL=you@example.com
DOCMOST_PASSWORD=your-password

# Optional: reuse a browser authToken cookie instead of email/password
# DOCMOST_AUTH_TOKEN=

# Optional: override session cache path (default ~/.docmost-community-mcp/session.json)
# DOCMOST_SESSION_PATH=

# Optional: refuse create/update/move/delete (search and read still work)
# DOCMOST_READ_ONLY=true

# --- HTTP mode (optional; stdio is the default) ---
# MCP_TRANSPORT=http
# Secret path segment, at least 32 characters of [A-Za-z0-9_-].
# Generate one with: openssl rand -hex 32
# MCP_PATH_SECRET=
# Public host name(s) the reverse proxy forwards, comma separated
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3001
# MCP_SESSION_IDLE_MINUTES=30

# --- Actors (optional): one Docmost account per model for writes ---
# Reads keep using DOCMOST_EMAIL. With actors set, write tools require an actor.
# DOCMOST_ACTORS=opus,sonnet
# DOCMOST_ACTOR_OPUS_EMAIL=
# DOCMOST_ACTOR_OPUS_PASSWORD=
# DOCMOST_ACTOR_SONNET_EMAIL=
# DOCMOST_ACTOR_SONNET_PASSWORD=
